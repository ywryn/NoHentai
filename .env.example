# Copy to .env for local work, or /etc/nohentai/nohentai.env on the server.
# Never expose these values via VITE_* or commit them to Git.
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_characters
# Generate ONCE: .venv/bin/python -m backend.cli generate-key
# Keep the key with your private backups; changing it prevents decryption.
CREDENTIAL_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: https://nohentai.com,https://www.nohentai.com
# Set an absolute persistent directory in production; systemd units set this.
# NOHENTAI_DATA_DIR=/var/lib/nohentai

# Optional bootstrap credentials. Values replaced in admin take precedence and
# are encrypted in SQLite; the API returns only whether each value is configured.
EXHENTAI_BASE_URL=https://exhentai.org/favorites.php
EXHENTAI_COOKIE_MEMBER_ID=
EXHENTAI_COOKIE_PASS_HASH=
EXHENTAI_COOKIE_IGNEOUS=
TRANS_PASSWORD=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_JSON_MODE=0
GOOGLE_VISION_API_KEY=
PADDLEOCR_API_TOKEN=
OCR_SPACE_KEY=
