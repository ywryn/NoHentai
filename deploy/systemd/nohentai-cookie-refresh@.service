[Unit]
Description=NoHentai isolated ExHentai cookie refresh

[Service]
Type=exec
User=nohentai
Group=nohentai
WorkingDirectory=/opt/nohentai
EnvironmentFile=/etc/nohentai/nohentai.env
Environment=NOHENTAI_DATA_DIR=/var/lib/nohentai
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/nohentai-browser
Environment=TMPDIR=/run/nohentai-cookie-refresh
ExecStart=/opt/nohentai/.venv/bin/python -m backend.cookie_refresh
StandardInput=socket
StandardOutput=null
StandardError=null
RuntimeDirectory=nohentai-cookie-refresh
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nohentai
KillMode=control-group
TimeoutStopSec=5s
RuntimeMaxSec=90s
MemoryHigh=350M
MemoryMax=450M
CPUQuota=50%
